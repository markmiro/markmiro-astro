# Bearer token
# https://github.com/astro-community/astro-embed/tree/main/packages/astro-embed-twitter#authentication
SECRET_TWITTER_TOKEN=

# Only used locally to try Jev from scripts. Moderation reads JEV_API_KEY from
# the Convex deployment's environment variables.
JEV_API_KEY=

# Clerk application → API keys
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Written by `npx convex dev` (CONVEX_DEPLOYMENT, CONVEX_URL) into .env.local.
# The site reads these two:
PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
