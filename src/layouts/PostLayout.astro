---
import type { CollectionEntry } from "astro:content";
import PostPagination from "@/components/PostPagination.astro";
import PostFooter from "@/components/post/PostFooter.astro";
import ItemLayout from "./ItemLayout.astro";

export interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, image } = post.data;
---

<ItemLayout
  title={title || "Untitled"}
  description={description || ""}
  image={image || ""}
>
  <slot />
  <Fragment slot="end">
    <PostFooter slug={post.id} title={title} />
    <PostPagination id={post.id} />
  </Fragment>
</ItemLayout>
