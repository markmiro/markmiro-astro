---
import { getCollection } from "astro:content";
import { compareFrontmatterDateDesc } from "@/lib/misc";
import PaginationLink from "./PaginationLink.astro";

export interface Props {
  id: string;
}

const { id } = Astro.props;

const sortedProjects = (
  await getCollection("projects", ({ data }) => data.draft !== true)
).sort(compareFrontmatterDateDesc);

const currentIndex = sortedProjects.findIndex((p) => p.id === id);

const prevProject = sortedProjects[currentIndex - 1];
const nextProject = sortedProjects[currentIndex + 1];
---

<div
  class="flex justify-between sticky bottom-0 border-t border-gray-200 divide-x"
>
  <PaginationLink
    align="left"
    href={prevProject && `/projects/${prevProject.id}`}
    title={prevProject?.data.title}
  >
    ← Previous
  </PaginationLink>
  <PaginationLink
    align="right"
    href={nextProject && `/projects/${nextProject.id}`}
    title={nextProject?.data.title}
  >
    Next →
  </PaginationLink>
</div>
