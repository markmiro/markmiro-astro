---
// A plain form that posts to Convex, so it works without JavaScript. Convex
// redirects back to /subscribe with a status.
---

<form
  action={`${import.meta.env.PUBLIC_CONVEX_SITE_URL}/subscribe`}
  method="post"
  class="flex flex-wrap gap-2"
>
  <label for="subscribe-email" class="sr-only">Email</label>
  <input
    id="subscribe-email"
    type="email"
    name="email"
    required
    autocomplete="email"
    placeholder="you@example.com"
    class="min-w-0 flex-1 rounded-md border border-c20 bg-c0 px-2 py-1.5 text-sm focus:border-c60 focus:outline-none"
  />
  {/* Honeypot: hidden from people, filled in by bots. */}
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="absolute -left-[9999px]"
  />
  <button
    class="rounded-md bg-c90 px-3 py-1.5 text-sm text-c0 transition-opacity hover:opacity-80"
  >
    Subscribe
  </button>
</form>
