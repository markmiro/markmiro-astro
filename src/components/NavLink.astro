---
export interface Props {
  href: string;
  isExact?: boolean;
}

const { href, isExact = false } = Astro.props;
const isActive = isExact
  ? Astro.url.pathname === href
  : Astro.url.pathname.startsWith(href);
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class={`flex h-8 items-center px-2 transition-colors sm:px-3 ${
    isActive ? "cursor-default bg-c100 text-c0" : "hover:bg-c8"
  }`}
>
  <slot />
</a>
