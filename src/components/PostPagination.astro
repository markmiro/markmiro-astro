---
import { getCollection } from "astro:content";
import { compareFrontmatterDateDesc } from "@/lib/misc";
import PaginationLink from "./PaginationLink.astro";

export interface Props {
  id: string;
}

const { id } = Astro.props;

const sortedPosts = (
  await getCollection("posts", ({ data }) => data.draft !== true)
).sort(compareFrontmatterDateDesc);

const currentIndex = sortedPosts.findIndex((p) => p.id === id);

const prevPost = sortedPosts[currentIndex - 1];
const nextPost = sortedPosts[currentIndex + 1];
---

<div
  class="flex justify-between sticky bottom-0 border-t border-gray-200 dark:border-gray-800 divide-x"
>
  <PaginationLink
    align="left"
    href={prevPost && `/posts/${prevPost.id}`}
    title={prevPost?.data.title}
  >
    ← Previous
  </PaginationLink>
  <PaginationLink
    align="right"
    href={nextPost && `/posts/${nextPost.id}`}
    title={nextPost?.data.title}
  >
    Next →
  </PaginationLink>
</div>
