---
import { getCollection } from "astro:content";
import { compareFrontmatterDateRangeDesc } from "@/lib/misc";
import ProjectImageThumb from "@/components/ProjectImageThumb.astro";
import ProjectItemDate from "@/components/ProjectItemDate.astro";

const allProjects = await getCollection(
  "projects",
  ({ data }) => data.draft !== true,
);
---

{
  allProjects.sort(compareFrontmatterDateRangeDesc).map((project) => (
    <a href={`/projects/${project.id}`} class="block group">
      <div class="font-bold mb-2">
        <div class="group-hover:underline">{project.data.title}</div>
        {project.data.date && <ProjectItemDate date={project.data.date} />}
      </div>
      <ProjectImageThumb slug={project.id} src={project.data.image} />
      {project.data.description && (
        <div class="text-sm my-1 leading-snug text-gray-500 dark:text-gray-400">
          {project.data.description}
        </div>
      )}
    </a>
  ))
}
