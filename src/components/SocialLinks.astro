---
import { Icon } from "astro-icon/components";

const links = [
  { href: "https://twitter.com/markmiro", icon: "tabler:brand-x", label: "X" },
  { href: "https://medium.com/@markmiro", icon: "tabler:brand-medium", label: "Medium" },
  { href: "https://www.linkedin.com/in/markmiro", icon: "tabler:brand-linkedin", label: "LinkedIn" },
  { href: "https://github.com/markmiro", icon: "tabler:brand-github", label: "GitHub" },
  { href: "https://codesandbox.io/u/markmiro", icon: "tabler:brand-codesandbox", label: "CodeSandbox" },
  { href: "https://codepen.io/markmiro", icon: "tabler:brand-codepen", label: "CodePen" },
];
---

{
  links.map(({ href, icon, label }) => (
    <li>
      <a href={href} class="inline-flex items-center gap-1">
        <Icon name={icon} class="size-4" aria-hidden="true" />
        {label}
      </a>
    </li>
  ))
}
