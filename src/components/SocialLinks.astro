---
import { Icon } from "astro-icon/components";

const links = [
  { href: "https://twitter.com/markmiro", icon: "simple-icons:x", label: "X" },
  { href: "https://medium.com/@markmiro", icon: "simple-icons:medium", label: "Medium" },
  { href: "https://www.linkedin.com/in/markmiro", icon: "simple-icons:linkedin", label: "LinkedIn" },
  { href: "https://github.com/markmiro", icon: "simple-icons:github", label: "GitHub" },
  { href: "https://codesandbox.io/u/markmiro", icon: "simple-icons:codesandbox", label: "CodeSandbox" },
  { href: "https://codepen.io/markmiro", icon: "simple-icons:codepen", label: "CodePen" },
  { href: "/rss.xml", icon: "simple-icons:rss", label: "RSS" },
];
---

{
  links.map(({ href, icon, label }) => (
    <li>
      <a href={href} class="inline-flex items-center gap-1">
        <Icon name={icon} class="size-4" aria-hidden="true" />
        {label}
      </a>
    </li>
  ))
}
