---
import { DEFAULT_PRESET, presets } from "@/lib/palette";
import ThemeMiniMap from "./ThemeMiniMap.astro";
import ThemePicker from "./ThemePicker";

// Themes for recoloring images. The default preset leaves them alone.
const themes = Object.fromEntries(
  presets.filter(({ id }) => id !== DEFAULT_PRESET).map(({ id, theme }) => [id, theme]),
);
---

<!--
  huet-react's embedded configurator (ThemePicker.tsx). It only renders in the
  browser, so the mini map stands in for it until it loads.
-->
<div class="flex h-8 items-center px-2 text-[13px] font-sans tracking-normal normal-case">
  <ThemePicker client:only="react">
    <span slot="fallback" class="flex h-[26px] items-center border border-c100 px-2">
      <ThemeMiniMap />
    </span>
  </ThemePicker>
</div>

<script
  type="application/json"
  id="preset-themes"
  set:html={JSON.stringify({ themes, defaultPreset: DEFAULT_PRESET })}
/>

<script>
  import type { Theme } from "huet";
  import { CUSTOM_PRESET, readCustomTheme } from "@/lib/customTheme";

  // Applies the theme picked in ThemePicker.tsx and recolors images into it.
  // Not part of the React island, so images on a non-default preset start
  // recoloring without waiting for huet-react to load.

  const root = document.documentElement;
  const { themes, defaultPreset }: {
    themes: Record<string, Theme>;
    defaultPreset: string;
  } = JSON.parse(document.getElementById("preset-themes")!.textContent!);

  function themeOf(id: string) {
    return id === CUSTOM_PRESET ? readCustomTheme()?.theme : themes[id];
  }

  // Loaded on demand, so visitors on the default preset never download it.
  let recoloring = false;
  function recolorImages() {
    const theme = themeOf(root.dataset.huet!) ?? null;
    if (!theme && !recoloring) return;
    recoloring = true;
    import("@/lib/recolorImages").then((module) => module.recolorImages(theme));
  }
  recolorImages();

  addEventListener("huet:select", (event) => {
    const preset = (event as CustomEvent<string>).detail;
    root.dataset.huet = preset;
    // Forget the choice when it's the default, so a new default applies.
    if (preset === defaultPreset) localStorage.removeItem("huet-preset");
    else localStorage.setItem("huet-preset", preset);
    recolorImages();
  });
</script>
