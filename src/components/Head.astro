---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { s3File } from "@/lib/s3";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link
  rel="icon"
  type="image/svg+xml"
  href={s3File("figma-export/favicon.svg")}
/>
<link
  rel="alternate"
  type="application/rss+xml"
  title="Mark Miro"
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />
<script is:inline>
  // Apply the theme before first paint to avoid a flash of the wrong colors.
  // An explicit choice from the theme toggle wins over the OS preference.
  (function () {
    var stored = localStorage.getItem("theme");
    var dark =
      stored === "dark" ||
      (stored !== "light" &&
        window.matchMedia("(prefers-color-scheme: dark)").matches);
    document.documentElement.classList.toggle("dark", dark);
  })();
</script>
<script is:inline>
  // Visiting /me marks a browser as Mark's, so analytics skip it.
  window.webAnalyticsBeforeSend = function (event) {
    return localStorage.getItem("mm:me") === "1" ? null : event;
  };
</script>
<Analytics />
