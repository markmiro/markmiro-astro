---
import { s3File } from "@/lib/s3";
export interface Props {
  slug?: string;
  src?: string;
}

const { slug, src } = Astro.props;
const imageSrc = src || (slug && s3File(`figma-export/project-${slug}-1x.png`));
const imageSrcset = src
  ? undefined
  : slug
    ? s3File(`figma-export/project-${slug}-2x.png 2x`)
    : undefined;
---

{
  imageSrc && (
    <div class="not-prose aspect-2/1 border border-gray-400 dark:border-gray-700 rounded-lg bg-gray-50 dark:bg-gray-900 overflow-hidden shadow-md shadow-gray-300 dark:shadow-black/50 group-hover:scale-[99%] transition-transform">
      <img
        class="size-full"
        alt={`Project ${slug || "preview"} preview image`}
        src={imageSrc}
        srcset={imageSrcset}
      />
    </div>
  )
}
