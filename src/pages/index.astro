---
// import Tools from "@/components/Tools.astro";
import Layout from "@/layouts/Layout.astro";
import { allExperiments, reference } from "@/lib/_content";
// import { s3File } from "@/lib/s3";
import ProjectsAll from "@/components/ProjectsAll.astro";
const title = "";
const description =
  "Hi, I'm a creative JavaScript and React developer / designer based in Sacramento, California.";
---

<Layout title={title} description={description}>
  <div class="px-8 py-20 md:px-10">
    <div class="ml-auto mr-auto max-w-lg md:max-w-3xl lg:max-w-6xl">
      <div
        class="flex flex-col md:flex-row items-center md:items-start gap-3 md:gap-8"
      >
        <div
          class="sm:text-lg md:text-2xl leading-tight sm:leading-snug max-w-[45ch]"
        >
          <div class="font-bold text-4xl lg:text-5xl">
            Mark Miro<span class="text-c30">nyuk</span>
          </div>
          <div class="mb-2"></div>
          {description}
          <div class="mb-1"></div>
          <a href="/about" class="text-base block underline">Learn More →</a>
        </div>
      </div>
    </div>
  </div>
  <hr />
  <div class="p-8 md:p-10">
    <div
      class="ml-auto mr-auto max-w-lg md:max-w-3xl lg:max-w-6xl grid md:grid-cols-2 gap-8"
    >
      <div class="prose lg:prose-xl md:col-span-2">
        <h2 class="">Latest</h2>
      </div>
      <ProjectsAll />
    </div>
  </div>
  <hr />
  <div class="p-8 lg:p-10">
    <div class="ml-auto mr-auto max-w-lg md:max-w-3xl lg:max-w-6xl">
      <div class="prose lg:prose-xl mb-6">
        <h2>Experiments</h2>
      </div>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          allExperiments
            .filter((ex) => ex?.draft !== true)
            .map((ex) => (
              <li>
                <a
                  href={ex.primaryLink}
                  class="flex h-full flex-col gap-2 border border-c12 p-5 transition-colors hover:bg-c4"
                >
                  <span class="font-bold leading-snug">{ex.title}</span>
                  {ex?.description && (
                    <span class="text-sm leading-snug text-c60">
                      {ex.description}
                    </span>
                  )}
                  <span class="mt-auto pt-2 text-sm text-c60">
                    {ex.primaryLinkText} ↗
                  </span>
                </a>
              </li>
            ))
        }
      </ul>
      <!-- <hr class="md:hidden" />
      <div class="prose lg:prose-xl">
        <h2>📚 Reference</h2>
        <ul>
          {
            reference.map((r) => (
              <li>
                <a href={r.url} class="">
                  {r.title} ↗
                </a>
              </li>
            ))
          }
        </ul>
        <hr />
        <h2>Tools</h2>
        <Tools />
      </div> -->
    </div>
  </div>
</Layout>
