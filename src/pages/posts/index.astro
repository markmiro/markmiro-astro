---
import ItemLayout from "@/layouts/ItemLayout.astro";
import { Icon } from "astro-icon/components";
import { compareFrontmatterDateDesc } from "@/lib/misc";
import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "posts",
  ({ data }) => data.draft !== true,
);
---

<ItemLayout title="Posts" description="My most recent blog posts">
  <ul>
    {
      allPosts.sort(compareFrontmatterDateDesc).map((post) => (
        <li>
          <div>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </div>
          {post.data.description && (
            <div class="text-c60">{post.data.description}</div>
          )}
          {post.data.date && (
            <time class="text-c60 text-sm" datetime={post.data.date}>
              {post.data.date}
            </time>
          )}
        </li>
      ))
    }
    <li>
      See more posts on{" "}
      <a
        href="https://medium.com/@markmiro"
        class="inline-flex items-center gap-1"
      >
        <Icon name="simple-icons:medium" class="size-4" aria-hidden="true" />
        Medium
      </a>.
    </li>
  </ul>
</ItemLayout>
