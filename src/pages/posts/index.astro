---
import ItemLayout from "@/layouts/ItemLayout.astro";
import { compareFrontmatterDateDesc } from "@/lib/misc";
import { getCollection } from "astro:content";

const allPosts = await getCollection(
  "posts",
  ({ data }) => data.draft !== true,
);
---

<ItemLayout title="Posts" description="My most recent blog posts">
  <ul>
    {
      allPosts.sort(compareFrontmatterDateDesc).map((post) => (
        <li>
          <div>
            {post.data.emoji && <span class="mr-2">{post.data.emoji}</span>}
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </div>
          {post.data.description && (
            <div class="text-gray-500 dark:text-gray-400">{post.data.description}</div>
          )}
          {post.data.date && (
            <time class="text-gray-500 dark:text-gray-400 text-sm" datetime={post.data.date}>
              {post.data.date}
            </time>
          )}
        </li>
      ))
    }
    <li>
      See more posts on <a href="https://medium.com/@markmiro">📝 Medium</a>.
    </li>
  </ul>
</ItemLayout>
